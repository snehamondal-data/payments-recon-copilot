# Copy to .env and adjust. .env is git-ignored; never commit a real key.
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_PREFIX=
DUCKDB_PATH=data/warehouse.duckdb
GROUND_TRUTH_PATH=data/ground_truth.duckdb
FX_RATES_PATH=data/ref/fx_rates.csv
SEED=42
AS_OF=2026-10-15

# Copilot (Slice 3)
ANTHROPIC_API_KEY=
RECON_MODEL=claude-sonnet-5-5
COPILOT_DB_PATH=data/copilot.duckdb
COPILOT_MAX_TOOL_CALLS=8
COPILOT_TIMEOUT_S=90
COPILOT_EFFORT=medium
# Blind mode: get_exception omits reason_code (show still displays it to the reviewer).
COPILOT_HIDE_REASON_CODE=false
# Where the six tools run: inprocess (default) or mcp (Slice 9c)
COPILOT_TOOL_BACKEND=inprocess
# The MCP server (python -m recon.mcp_server) appends one JSON line per tool call here
MCP_ACCESS_LOG=data/mcp_access.jsonl

# Snowflake (Slice 5). Key-pair auth; generate the keys into secrets/ (git-ignored).
# duckdb (default) or snowflake: where the loader writes and the copilot reads
WAREHOUSE_ENGINE=duckdb
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=RECON_WH
SNOWFLAKE_DATABASE=RECON
SNOWFLAKE_LOADER_USER=RECON_LOADER
SNOWFLAKE_LOADER_ROLE=RECON_LOADER_ROLE
SNOWFLAKE_LOADER_KEY_PATH=secrets/recon_loader_rsa_key.p8
SNOWFLAKE_AGENT_USER=RECON_AGENT
SNOWFLAKE_AGENT_ROLE=RECON_AGENT_ROLE
SNOWFLAKE_AGENT_KEY_PATH=secrets/recon_agent_rsa_key.p8
